  "threads": {
    "bandit_hunt": {
      "id": "bandit_hunt",
      "title": "盜賊討伐",
      "desc": "黑森林裡出現了一群盜賊，商隊都不敢上路，商人 karen 需要你的幫助。",
      "quality": "bandit_hunt",
      "values": {
        "1": {
          "journal": "與 xi 對話了解情況",
          "reward": "金幣 x100"
        },
        "2": {
          "journal": "前往黑森林，清光盜賊 ({bandit_hunt.kills}/3)",
          "pos": "m/m_03x05"
        },
        "3": {
          "journal": "從盜賊身上取得匕首"
        },
        "4": {
          "journal": "任務完成，跟 karen 回報任務"
        },
        "10": {
          "journal": "已向 karen 回報，領取獎勵",
          "end": true
        }
      }
    },
    "wolf_hunt": {
      "id": "wolf_hunt",
      "title": "屠夫的生意經",
      "desc": "黑森林的野狼氾濫，xi 的肉舖快沒貨了，想找人幫忙獵狼取皮，順便帶個口信給城裡的商人 karen。",
      "quality": "wolf_hunt",
      "values": {
        "1": {
          "journal": "前往黑森林狩獵，擊殺野狼 ({wolf_hunt.kills}/3)",
          "pos": "m/m_03x05",
          "reward": "金幣 x120、斧頭 x1"
        },
        "2": {
          "journal": "剝下狼皮"
        },
        "3": {
          "journal": "帶著狼皮去找商人 karen 談談"
        },
        "4": {
          "journal": "任務完成，回去跟 xi 回報"
        },
        "9": {
          "journal": "你把狼皮直接賣給了 xi",
          "end": true
        },
        "10": {
          "journal": "已向 xi 回報，領取獎勵",
          "end": true
        }
      }
    },
    "pelt_trade": {
      "id": "pelt_trade",
      "title": "跑腿的交涉",
      "desc": "黑森林的野狼問題解決後，xi 想跟 karen 談長期收購狼皮的生意，請你幫忙帶提案去交涉。",
      "quality": "pelt_trade",
      "values": {
        "1": {
          "journal": "帶著提案去找商人 karen 談交涉條件",
          "reward": "金幣 x100"
        },
        "2": {
          "journal": "任務完成，回去跟 xi 回報"
        },
        "10": {
          "journal": "已向 xi 回報，領取謝禮",
          "end": true
        }
      }
    }
  },
  "storylets": [
    {
      "id": "hunt_ask",
      "who": "karen",
      "requires": "bandit_hunt==0",
      "label": "關於任務",
      "text": "@n_hunt_ask"
    },
    {
      "id": "hunt_xi",
      "who": "xi",
      "requires": "bandit_hunt==1",
      "label": "關於盜賊",
      "text": "@n_hunt_xi"
    },
    {
      "id": "hunt_kill",
      "requires": "bandit_hunt==2 && bandit_hunt.kills>=3",
      "on": [
        "kill"
      ],
      "effects": [
        "bandit_hunt=3",
        "stop bandit_hunt.kills"
      ]
    },
    {
      "id": "hunt_knife",
      "requires": "bandit_hunt==3 && item:sword_01:1",
      "on": [
        "item",
        "quality"
      ],
      "effects": [
        "bandit_hunt=4"
      ]
    },
    {
      "id": "hunt_report",
      "who": "karen",
      "requires": "bandit_hunt>=1 && bandit_hunt<10",
      "label": "關於任務",
      "text": "@n_hunt_report"
    },
    {
      "id": "wolf_ask",
      "who": "xi",
      "requires": "wolf_hunt==0",
      "label": "關於任務",
      "text": "@n_wolf_ask"
    },
    {
      "id": "wolf_kill",
      "requires": "wolf_hunt==1 && wolf_hunt.kills>=3",
      "on": [
        "kill"
      ],
      "effects": [
        "wolf_hunt=2",
        "stop wolf_hunt.kills"
      ]
    },
    {
      "id": "wolf_pelt",
      "requires": "wolf_hunt==2 && item:plet:1",
      "on": [
        "item",
        "quality"
      ],
      "effects": [
        "wolf_hunt=3"
      ]
    },
    {
      "id": "wolf_karen",
      "who": "karen",
      "requires": "wolf_hunt==3 && item:plet:1",
      "label": "關於黑森林的狼皮",
      "text": "@n_wolf_karen"
    },
    {
      "id": "wolf_report",
      "who": "xi",
      "requires": "wolf_hunt>=1 && wolf_hunt<9",
      "label": "關於任務",
      "text": "@n_wolf_report"
    },
    {
      "id": "wolf_sell",
      "who": "xi",
      "tease": "wolf_hunt==2",
      "requires": "wolf_hunt==3 && item:plet:1",
      "label": "把狼皮直接賣給你",
      "hint": "需要狼皮",
      "text": "……也好，省得你跑一趟，那我自己收了。",
      "effects": [
        "take plet 1",
        "wolf_hunt=9",
        "gold+80"
      ]
    },
    {
      "id": "wolf_grudge",
      "who": "karen",
      "requires": "wolf_hunt==9 && !_grudge",
      "text": "喂！你給我過來！",
      "on": [
        "see"
      ],
      "effects": [
        "approach n_wolf_grudge"
      ]
    },
    {
      "id": "trade_ask",
      "who": "xi",
      "requires": "wolf_hunt==10 && pelt_trade==0",
      "label": "關於任務",
      "text": "@n_trade_ask"
    },
    {
      "id": "trade_karen",
      "who": "karen",
      "requires": "pelt_trade==1",
      "label": "轉達 xi 的提案",
      "text": "@n_trade_karen"
    },
    {
      "id": "trade_report",
      "who": "xi",
      "requires": "pelt_trade>=1 && pelt_trade<10",
      "label": "關於任務",
      "text": "@n_trade_report"
    }
  ],
